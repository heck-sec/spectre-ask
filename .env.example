# Clerk (default auth for Spectre Ask / Lumino)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# OpenRouter — single provider for classify + all chat models
OPENROUTER_API_KEY=

# Used in OpenRouter HTTP-Referer header
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres — HeckSec Vault org project (spectre-ask / vault)
# Project ref: qtksakozbfptzsrmvvom
NEXT_PUBLIC_SUPABASE_URL=https://qtksakozbfptzsrmvvom.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth note: Clerk is the default. For a self-hosted / less-corporate OIDC
# alternative with orgs + roles, prefer Zitadel (Apache-2.0, OIDC/SAML).
# Auth adapter interface can swap providers later without changing vault-core.
